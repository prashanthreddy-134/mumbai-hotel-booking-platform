generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      String    @default("CUSTOMER")
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Hotel {
  id          String         @id @default(uuid())
  name        String
  description String
  location    String
  address     String
  price       Float
  rating      Float          @default(0)
  image       String?
  createdAt   DateTime       @default(now())
  rooms       Room[]
  images      HotelImage[]
  amenities   HotelAmenity[]
  policies    HotelPolicy[]
}

model HotelImage {
  id        String  @id @default(uuid())
  url       String
  altText   String?
  sortOrder Int     @default(0)
  hotelId   String
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, sortOrder])
}

model HotelAmenity {
  id      String @id @default(uuid())
  name    String
  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, name])
}

model HotelPolicy {
  id          String @id @default(uuid())
  category    String
  title       String
  description String
  hotelId     String
  hotel       Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

model Room {
  id        String        @id @default(uuid())
  name      String
  capacity  Int
  price     Float
  hotelId   String
  hotel     Hotel         @relation(fields: [hotelId], references: [id])
  bookings  Booking[]
  amenities RoomAmenity[]
}

model RoomAmenity {
  id     String @id @default(uuid())
  name   String
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, name])
}

model Booking {
  id              String    @id @default(uuid())
  userId          String
  roomId          String
  checkIn         DateTime
  checkOut        DateTime
  status          String    @default("PENDING")
  total           Float
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  guestCount      Int       @default(1)
  specialRequests String?
  holdExpiresAt   DateTime?
  createdAt       DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id])
  room     Room      @relation(fields: [roomId], references: [id])
  payments Payment[]

  @@index([roomId, status, checkIn, checkOut])
  @@index([userId, createdAt])
  @@index([status, holdExpiresAt])
}

model Payment {
  id                String  @id @default(uuid())
  bookingId         String
  booking           Booking @relation(fields: [bookingId], references: [id])
  amount            Float
  currency          String  @default("INR")
  status            String  @default("CREATED")
  provider          String  @default("RAZORPAY")
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?
  refundId          String? @unique
  refundStatus      String?
  refundedAmount    Float?
  failureReason     String?

  // Refund processing lock and recovery information.
  refundLockToken         String?
  refundLockExpiresAt     DateTime?
  refundAttempts          Int       @default(0)
  refundCreateAttemptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId, createdAt])
  @@index([status])
  @@index([refundLockExpiresAt])
}

model PaymentWebhookEvent {
  id          String    @id @default(uuid())
  provider    String    @default("RAZORPAY")
  eventId     String    @unique
  eventType   String
  processedAt DateTime?

  // Webhook processing lock and recovery information.
  processingToken         String?
  processingLockExpiresAt DateTime?
  attempts                Int       @default(0)
  lastError               String?

  createdAt DateTime @default(now())

  @@index([processingLockExpiresAt])
}
